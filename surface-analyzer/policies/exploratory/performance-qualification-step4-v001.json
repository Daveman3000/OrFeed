    "report": [
      "3_of_3_supported_and_unsupported_components",
      "exactly_2_of_3_union_connected_components",
      "r_per_trade_only_blocker_connected_components",
      "profit_factor_only_blocker_connected_components",
      "romad_only_blocker_connected_components",
