  },
  "component_support": {
    "context_p1_cells": "number_of_evaluable_cells_jointly_passing_p1_in_the_fixed_context",
    "minimum_connected_cells_formula": "max(16, min(32, ceil(0.005 * context_p1_cells)))",
    "same_requirement_at_every_rung_and_for_diagnostic_components": true,
    "cell_count_is_independent_trade_sample_size": false
  },
  "lineage": {
